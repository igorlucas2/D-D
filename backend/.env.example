# Configuração local. Codifique caracteres especiais nas credenciais.
DATABASE_URL="mysql://USUARIO:SENHA_CODIFICADA@localhost:3306/rpg"
PORT=3001

# Obrigatório: mínimo de 32 caracteres. Sem um segredo forte o servidor não
# inicia (src/config/env.validation.ts). Gere com:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=""
JWT_EXPIRES_IN=1d

# Origens extras liberadas para CORS e para o handshake do Socket.IO
# (túnel/domínio próprio), separadas por vírgula. Sem isto, apenas
# localhost:3000 e 127.0.0.1:3000 são aceitos.
ELDORIA_ALLOWED_ORIGINS=""

# Hosts públicos do túnel, sem esquema (ex.: eldoria.exemplo.com.br).
# Cada host vira origem http e https automaticamente.
ELDORIA_PUBLIC_HOSTS=""

# 1 = confia no primeiro proxy; loopback (padrão) = confia só em proxy local
# (o Next na mesma máquina); 0 = não confia em cabeçalhos de proxy.
TRUST_PROXY=loopback

# E-mails (separados por vírgula) autorizados a ações administrativas, como
# sincronizar o catálogo SRD. Vazio = qualquer conta autenticada (com limite).
ADMIN_EMAILS=""

# Logs estruturados em JSON (pino): fatal|error|warn|info|debug|trace|silent.
LOG_LEVEL=info

# 1 liga GET /api/metrics (formato Prometheus). Com METRICS_TOKEN definido,
# o endpoint passa a exigir Authorization: Bearer <token>.
METRICS_ENABLED=0
METRICS_TOKEN=""

# 1 liga a documentacao interativa em /api/docs e o JSON em /api/docs-json.
# Em producao fica desligada por padrao (evita expor o mapa da API).
OPENAPI_ENABLED=1

# Opcional: assistente do mestre (Anthropic).
# ANTHROPIC_API_KEY=""

# Opcional: copiloto local (Ollama).
# GAME_MASTER_OLLAMA_URL="http://127.0.0.1:11434"
# GAME_MASTER_MODEL="gemma2:9b"
# GAME_MASTER_TIMEOUT_MS=90000

# Somente para a ferramenta de migração avulsa; use a URL real do destino.
# MYSQL_DATABASE_URL="mysql://USUARIO:SENHA_CODIFICADA@localhost:3306/rpg"
