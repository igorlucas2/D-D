  @@index([campaignId])
  @@index([currentMapId])
}

// =====================================================================
// IM-11 - Conversa da mesa e idiomas do mundo
// =====================================================================

// Idioma (entrada IDIOMA do modulo Mundo) que um personagem conhece. Ensinado
// pelo mestre.
model CharacterLanguage {
  characterId String
  languageId  String
  createdAt   DateTime @default(now())

  character Character          @relation(fields: [characterId], references: [id], onDelete: Cascade)
  language  CampaignWorldEntry @relation(fields: [languageId], references: [id], onDelete: Cascade)

  @@id([characterId, languageId])
  @@index([languageId])
}

enum ChatKind {
  IC // em personagem
  OOC // fora do personagem
  EMOTE // acao (/me)
  WHISPER // sussurro: destinatarios e mestre
}

model ChatMessage {
  id          String   @id @default(cuid())
  campaignId  String
  authorId    String
  characterId String?
  kind        ChatKind @default(IC)
  content     String @db.LongText
  // Fala em um idioma do mundo: quem nao conhece recebe o texto embaralhado.
  languageId  String?
  createdAt   DateTime @default(now())

  campaign   Campaign               @relation(fields: [campaignId], references: [id], onDelete: Cascade)
