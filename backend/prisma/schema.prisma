  copilotTurn GameMasterTurn?
  consequence ScheduledConsequence?
  @@unique([campaignId, id])
  @@unique([campaignId, sequence])
  @@unique([campaignId, requestKey])
  @@index([campaignId, gameMinute])
}
model EventEntity {
  campaignId String
  eventId String
  entityId String
  event StoryEvent @relation(fields:[campaignId, eventId], references:[campaignId, id], onDelete:Cascade)
  entity CampaignEntity @relation(fields:[campaignId, entityId], references:[campaignId, id], onDelete:Restrict, onUpdate:Restrict)
  @@id([eventId, entityId])
  @@index([entityId, eventId])
}
model StoryFact {
  id String @id @default(cuid())
  campaignId String
  key String
  kind StoryFactKind
  classification StoryFactClass
  predicate String @default("ASSERTION")
  currentVersion Int @default(1)
  boundObjectId String? @unique
  lore CampaignLore @relation(fields:[campaignId], references:[campaignId], onDelete:Cascade)
  revisions StoryFactRevision[]
  subjects StoryFactSubject[]
  boundObject CampaignPlotObject? @relation(fields:[campaignId, boundObjectId], references:[campaignId, entityId], onDelete:Restrict, onUpdate:Restrict)
  @@unique([campaignId, boundObjectId])
  @@unique([campaignId, id])
  @@unique([campaignId, key])
}
model StoryFactSubject {
  campaignId String
  factId String
  entityId String
  fact StoryFact @relation(fields:[campaignId, factId], references:[campaignId, id], onDelete:Cascade)
  entity CampaignEntity @relation(fields:[campaignId, entityId], references:[campaignId, id], onDelete:Restrict, onUpdate:Restrict)
  @@id([factId, entityId])
  @@index([entityId])
}
model StoryFactRevision {
  id String @id @default(cuid())
  campaignId String
  factId String
  version Int
  text String @db.LongText
  // Editorial evaluation of a claim; never exposed through character knowledge.
  evaluation String?
  sourceEventId String
  audienceId String
  fact StoryFact @relation(fields:[campaignId, factId], references:[campaignId, id], onDelete:Cascade)
  event StoryEvent @relation(fields:[campaignId, sourceEventId], references:[campaignId, id], onDelete:Restrict, onUpdate:Restrict)
  audience StoryAudience @relation(fields:[campaignId, audienceId], references:[campaignId, id], onDelete:Restrict, onUpdate:Restrict)
  observations EntityKnowledge[]
  @@unique([campaignId, id])
  @@unique([factId, version])
}
model EntityKnowledge {
  id String @id @default(cuid())
  campaignId String
  knowerEntityId String
  factRevisionId String
  stance StoryKnowledgeStance
  source String @db.Text
  sourceEventId String
  knower CampaignEntity @relation(fields:[campaignId, knowerEntityId], references:[campaignId, id], onDelete:Restrict, onUpdate:Restrict)
  revision StoryFactRevision @relation(fields:[campaignId, factRevisionId], references:[campaignId, id], onDelete:Restrict, onUpdate:Restrict)
  event StoryEvent @relation(fields:[campaignId, sourceEventId], references:[campaignId, id], onDelete:Restrict, onUpdate:Restrict)
  @@unique([campaignId, knowerEntityId, factRevisionId, sourceEventId])
  @@index([knowerEntityId, factRevisionId])
}
model StoryRelationship {
