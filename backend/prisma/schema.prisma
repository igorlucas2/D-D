  npc CampaignNpc? @relation("ScheduledNpc", fields:[campaignId, npcEntityId], references:[campaignId, entityId], onDelete:Restrict, onUpdate:Restrict)
  activeNpc CampaignNpc? @relation("ActiveNpcJourney")
  route TravelRoute? @relation(fields:[campaignId, routeId], references:[campaignId, id], onDelete:Restrict, onUpdate:Restrict)
  parent ScheduledConsequence? @relation("JourneyArrival", fields:[campaignId, parentId], references:[campaignId, id], onDelete:Restrict, onUpdate:Restrict)
  arrival ScheduledConsequence? @relation("JourneyArrival")
  event StoryEvent? @relation(fields:[campaignId, resultEventId], references:[campaignId, id], onDelete:Restrict, onUpdate:Restrict)
  @@unique([campaignId, id])
  @@unique([campaignId, requestKey])
  @@unique([campaignId, parentId])
  @@unique([campaignId, resultEventId])
  @@index([campaignId, status, dueMinute])
}

model OutboxEvent {
  id String @id @default(cuid())
  campaignId String
  eventId String @unique
  status OutboxStatus @default(PENDING)
  attempts Int @default(0)
  availableAt DateTime @default(now())
  leaseToken String?
  leaseUntil DateTime?
  deliveredAt DateTime?
  lastError String?
  event StoryEvent @relation(fields:[campaignId, eventId], references:[campaignId, id], onDelete:Cascade)
  @@unique([campaignId, eventId])
  @@index([status, availableAt])
  @@index([status, leaseUntil])
}
