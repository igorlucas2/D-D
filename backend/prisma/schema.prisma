// MI-02: immutable package snapshot and campaign-scoped world instances.
enum LoreEntityKind {
  PLACE
  NPC
  FACTION
  OBJECT
  CHARACTER
}

model LorePackVersion {
  id String @id @default(cuid())
  packKey String
  version String
  contentHash String @db.Char(64)
  status String
  formatVersion Int
  snapshot String @db.LongText
  createdAt DateTime @default(now())
