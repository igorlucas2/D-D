  promises StoryPromise[]
  threads StoryThread[]
  @@unique([campaignId, id])
}
model StoryAudienceMember {
  campaignId String
  audienceId String
  userId String
  audience StoryAudience @relation(fields:[campaignId, audienceId], references:[campaignId, id], onDelete:Cascade)
  user User @relation(fields:[userId], references:[id], onDelete:Cascade)
  @@id([audienceId, userId])
  @@index([userId])
}
model StoryEvent {
  id String @id @default(cuid())
  campaignId String
  sequence Int
  kind StoryEventKind
  gameMinute Int
  recordedAt DateTime @default(now())
  actorKind String
  actorUserId String?
  actorName String
  requestKey String?
  requestHash String? @db.Char(64)
  audienceId String
  summary String @db.Text
  payload String @db.LongText
  correctsEventId String?
  lore CampaignLore @relation(fields:[campaignId], references:[campaignId], onDelete:Cascade)
  actor User? @relation(fields:[actorUserId], references:[id], onDelete:SetNull)
  audience StoryAudience @relation(fields:[campaignId, audienceId], references:[campaignId, id], onDelete:Restrict, onUpdate:Restrict)
  corrects StoryEvent? @relation("StoryCorrections", fields:[campaignId, correctsEventId], references:[campaignId, id], onDelete:Restrict, onUpdate:Restrict)
  corrections StoryEvent[] @relation("StoryCorrections")
  entities EventEntity[]
  factRevisions StoryFactRevision[]
  observations EntityKnowledge[]
  relationships StoryRelationship[]
  promises StoryPromise[]
  threads StoryThread[]
  outbox OutboxEvent?
