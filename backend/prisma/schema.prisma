// MI-03: append-only events and observations, separate from current truth.
enum StoryVisibility {
  MASTER
  PUBLIC
  RECIPIENTS
}
enum StoryFactKind {
  FACT
  CLAIM
}
enum StoryFactClass {
  FIXED
  MUTABLE
}
enum StoryKnowledgeStance {
  KNOWN
  BELIEVED
  SUSPECTED
}
enum StoryPromiseStatus {
  OPEN
  FULFILLED
  BROKEN
  CANCELLED
}
enum StoryThreadStatus {
  OPEN
  RESOLVED
  ABANDONED
}
enum StoryEventKind {
  GENESIS
  NOTE
  FACT_CREATE
  FACT_UPDATE
  CORRECTION
  DISCOVER
  RELATIONSHIP
  PROMISE_CREATE
  PROMISE_RESOLVE
  THREAD_UPDATE
  DOMAIN_INITIALIZED
  GROUP_TRAVEL
  GROUP_REST
  OBJECT_TAKEN
  OBJECT_DROPPED
  CLOCK_ADVANCED
