  @@unique([packKey, version])
}

model CampaignLore {
  campaignId String @id
  packVersionId String
  installedById String
  requestKey String?
  requestHash String? @db.Char(64)
  installedHash String @db.Char(64)
  catalogSnapshots String @db.LongText
