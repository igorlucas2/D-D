# Normaliza fim de linha: LF no repositório.
* text=auto eol=lf

# Scripts do Windows mantêm CRLF para compatibilidade com cmd/PowerShell.
*.ps1 text eol=crlf
*.cmd text eol=crlf
*.bat text eol=crlf

# Binários
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.gif binary
*.ico binary
*.rar binary
*.zip binary
*.db binary
