# O navegador chama a API pela mesma origem; o Next repassa ao backend
# (ver next.config.ts). Funciona em localhost e pelo túnel do Cloudflare.
NEXT_PUBLIC_API_URL=/api
BACKEND_URL=http://localhost:3001

# Domínios públicos liberados no servidor de desenvolvimento (vírgula).
ELDORIA_PUBLIC_HOSTS=

# Opcional: restringe /api/image-proxy a estes hosts (vírgula). Aceita
# `example.com` e `*.example.com`. Vazio = qualquer host público (a rede
# interna continua bloqueada de qualquer forma).
IMAGE_PROXY_ALLOWED_HOSTS=
